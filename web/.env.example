# ============================================================================
# ローカル開発用のテンプレート。`cp .env.example .env` で使い始められます。
# 本番（Vercel）では同じキーを Vercel の Environment Variables に設定します。
# 本番向けの値については docs/deployment.md を参照してください。
# このファイルに実際のシークレットを書かないこと（.env は git 管理外）。
# ============================================================================

# ---------------------------------------------------------------- データベース
# 開発時は `npm run db:start` が起動する埋め込み PostgreSQL を指します。
#
# pgbouncer=true は開発用 PGlite の制約によるものです。PGlite は複数の接続で
# 1 つの PostgreSQL セッションを共有するため、名前付きプリペアドステートメント
# が衝突します。このフラグで Prisma がそれを使わなくなります。
# connection_limit=1 も PGlite が同時接続に弱いための開発用指定です。
#
# 本番（Neon）ではプーラー経由のホストに差し替えます。例:
#   DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require&pgbouncer=true&connection_limit=1"
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/postgres?pgbouncer=true&connection_limit=1"

# マイグレーション専用の直結 URL。プーラー経由では DDL を流せません。
# ローカルでは DATABASE_URL と同じ値で構いません。
# 本番（Neon）は `-pooler` の付かないホストを指定します。例:
#   DIRECT_URL="postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:55432/postgres"

# ---------------------------------------------------------------------- 認証
# セッショントークンのハッシュ用ソルト。本番では必ず別の値にしてください。
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="03b91992eaedea3905440a3f504f73481273d5381365a605866a0094a7d13113"

# -------------------------------------------------------------------- アプリ
# 決済後の戻り先と CSRF 判定に使います。本番では実際の https URL を設定します。
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 起動時に管理者へ昇格させるメールアドレス（カンマ区切り、任意）
ADMIN_EMAILS="admin@onemake.local"

# ------------------------------------------------------------------- 決済
# mock = ローカル専用のテスト決済。本番ホスト・sk_live・Vercel production では
# 自動的に無効になります。本番では "stripe" にしてください。
PAYMENT_PROVIDER="mock"

# ローカル確認用アカウントの投入可否。本番では必ず false。
SEED_LOCAL_USERS="true"

# ------------------------------------------------------------------- Stripe
# STRIPE_SECRET_KEY は絶対にクライアントへ渡さないこと（NEXT_PUBLIC_ を付けない）。
# ローカル / Preview は sk_test_、本番のみ sk_live_ を使います。
STRIPE_SECRET_KEY=""

# Stripe ダッシュボードの Webhook エンドポイント（/api/stripe/webhook）の署名シークレット。
# ローカルでは `npm run stripe:listen` が表示する whsec_ を使います。
# これが無いと決済は通っても診断枠が付与されません。本番では必須です。
STRIPE_WEBHOOK_SECRET=""

# プランごとの Price ID。設定したプランだけが購入可能になります。
# テスト用は `npm run stripe:setup-test-price` で作成できます。
STRIPE_PRICE_ID_ONE_TIME=""
STRIPE_PRICE_ID_MONTHLY_5=""
STRIPE_PRICE_ID_MONTHLY_UNLIMITED=""

# 互換用（未設定なら one_time のローカル Test Mode にだけ使う）
STRIPE_PRICE_ID=""
LOCAL_TEST_PRICE_ID=""
