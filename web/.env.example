# ---------------------------------------------------------------- データベース
# 開発時は `npm run db:start` が起動する埋め込み PostgreSQL を指します。
# 本番はマネージド PostgreSQL の接続文字列に差し替えてください
# （そのときは pgbouncer の指定を外してください。PgBouncer 等を
#  トランザクションモードで挟む場合のみ付けます）。
#
# pgbouncer=true は開発用 PGlite の制約によるものです。PGlite は複数の接続で
# 1 つの PostgreSQL セッションを共有するため、名前付きプリペアドステートメント
# が衝突します。このフラグで Prisma がそれを使わなくなります。
# pgbouncer=true は名前付きプリペアドステートメントを止めるため、
# connection_limit=1 は PGlite が同時接続に弱いための開発用指定です。
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/postgres?pgbouncer=true&connection_limit=1"

# ---------------------------------------------------------------------- 認証
# セッショントークンのハッシュ用ソルト。本番では必ず変更してください。
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-in-production-with-a-32-byte-random-hex-string"

# --------------------------------------------------------------- 診断エンジン
# Python(FastAPI) のベース URL。外部には公開しないこと。
DIAGNOSIS_ENGINE_URL="http://127.0.0.1:8000"

# -------------------------------------------------------------------- アプリ
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 起動時に管理者へ昇格させるメールアドレス（カンマ区切り、任意）
ADMIN_EMAILS="admin@onemake.local"

# ------------------------------------------------------------------- 決済
# mock = ローカル専用のテスト決済（本番ホスト・sk_live・Vercel production では無効）
# stripe = Stripe Checkout（STRIPE_SECRET_KEY と STRIPE_PRICE_ID が必要）
# 未設定かつ Stripe キーが空なら有料導線は「準備中」
PAYMENT_PROVIDER="mock"

# ローカル確認用ユーザー（admin / user / paid @onemake.local）をシードする
# PAYMENT_PROVIDER=mock のときも投入されます。本番では false にしてください。
SEED_LOCAL_USERS="true"
# SEED_LOCAL_PASSWORD="onemake-local-pass"

# ------------------------------------------------------------------- Stripe
# STRIPE_SECRET_KEY は絶対にクライアントへ渡さないこと（NEXT_PUBLIC_ を付けない）。
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Test Mode または本番の Price ID。コードへ埋め込まない。
# 未作成なら `cd web && npm run stripe:setup-test-price` で Test Mode の Price を作る。
STRIPE_PRICE_ID_ONE_TIME=
STRIPE_PRICE_ID_MONTHLY_5=
STRIPE_PRICE_ID_MONTHLY_UNLIMITED=

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
